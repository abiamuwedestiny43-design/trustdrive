# ── Server ──
PORT=5000
NODE_ENV=development

# ── MongoDB ──
# Local:  mongodb://localhost:27017/trustdrive
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/trustdrive
MONGO_URI=mongodb://localhost:27017/trustdrive

# ── JWT ──
JWT_SECRET=trustdrive_super_secret_jwt_key_change_in_prod

# ── Twilio SMS OTP ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or use a specific phone number:
# TWILIO_PHONE_NUMBER=+1415XXXXXXX
